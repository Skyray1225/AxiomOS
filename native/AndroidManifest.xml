<?xml version="1.0" encoding="utf-8"?>
<!-- Prototype natif de l'accueil. Appli séparée : elle n'est pas l'accueil par défaut,
     mais apparaît dans la liste des applis (« Accueil natif ») ; ou : am start -n fr.accueil.natif/.MainActivity -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.accueil.natif"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />

    <uses-permission android:name="android.permission.INTERNET" /> <!-- météo (Open-Meteo) -->
    <!-- filtre anti lumière bleue par-dessus toutes les applis (autorisation donnée une fois par appops) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11 : nécessaire pour voir les autres applis installées -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Accueil natif"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:hardwareAccelerated="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <!-- Écran d'accueil de la box (touche Accueil, démarrage) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Visible aussi dans le dock de l'accueil web -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Filtre anti lumière bleue : voile ambré sur tout l'écran, réglé dans les Préférences -->
        <service android:name=".BlueFilter" android:exported="false" />
        <!-- Économiseur d'écran : inactif tant qu'on ne le choisit pas (settings secure screensaver_components) -->
        <service
            android:name=".AccueilDream"
            android:exported="true"
            android:label="Accueil natif"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Gardien Kids : inactif tant qu'on ne l'active pas dans les services d'accessibilité -->
        <service
            android:name=".KidsGuard"
            android:exported="false"
            android:label="Gardien Kids (natif)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/kids_guard" />
        </service>
    </application>
</manifest>
